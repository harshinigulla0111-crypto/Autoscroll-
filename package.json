{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "autoscroll-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AutoScroll application root workspace launcher",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start": "node backend/server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.cpSync('frontend/dist', 'dist', {recursive: true});\"",
    "build:apk": "python scripts/generate_apk.py",
    "share": "node scripts/share-tunnel.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  }
}
